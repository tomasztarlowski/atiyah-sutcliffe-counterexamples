section FinalSigns26
attribute [local irreducible] Matrix.det stereoDenR

private lemma pos_re_of_CFpMem' {S : ℤ} (hS : 0 < S) {iv : CFpIv} {z : ℂ}
    (hmem : CFpIv.CFpMem S iv z) (hlo : 0 < iv.re.lo) : 0 < z.re := by
  have hS_pos : (0 : ℝ) < (S : ℝ) := by exact_mod_cast hS
  have hlo_R : (0 : ℝ) < (iv.re.lo : ℝ) := by exact_mod_cast hlo
  have hprod : 0 < (S : ℝ) * z.re := lt_of_lt_of_le hlo_R hmem.1.1
  exact (mul_pos_iff.mp hprod).resolve_right (fun h => by linarith [h.1]) |>.2

private lemma neg_re_of_CFpMem' {S : ℤ} (hS : 0 < S) {iv : CFpIv} {z : ℂ}
    (hmem : CFpIv.CFpMem S iv z) (hhi : iv.re.hi < 0) : z.re < 0 := by
  have hS_pos : (0 : ℝ) < (S : ℝ) := by exact_mod_cast hS
  have hhi_R : (iv.re.hi : ℝ) < 0 := by exact_mod_cast hhi
  have hprod : (S : ℝ) * z.re < 0 := lt_of_le_of_lt hmem.1.2 hhi_R
  exact (mul_neg_iff.mp hprod).resolve_right (fun h => by linarith [h.1]) |>.2

private lemma stereoMat_det_mem {sn : ℤ} (hsn : 1 ≤ sn) {tbl : List ℤ}
    (hok : rhoTableOk26 (pts26OfSn sn) tbl = true) {out : CFpIv}
    (hg : gauss26 sn tbl = (true, out)) :
    CFpIv.CFpMem S26 out (atiyahMat (stereoSpinor (x26Clamp (sn : ℝ)).1)).det := by
  have h := gaussDetCIv_mem S26_pos hg (CFpIv.ofInt_mem S26 1) (rows26_mem hsn hok)
  simpa using h

private lemma re_div_ofReal (z : ℂ) (r : ℝ) : (z / (r : ℂ)).re = z.re / r := by
  simp [div_eq_mul_inv, ← Complex.ofReal_inv, Complex.mul_re]

private lemma cast_int_8 : ((8 : ℤ) : ℝ) = (8 : ℝ) := by norm_num
private lemma cast_int_10 : ((10 : ℤ) : ℝ) = (10 : ℝ) := by norm_num

lemma atiyahDet_x26Clamp_8_re_pos : 0 < (atiyahDet (x26Clamp 8)).re := by
  have hg := gauss26_8_eq
  have hlo := Q8_25_re_pos
  have hmem := stereoMat_det_mem (by decide : (1 : ℤ) ≤ 8) rho8_ok hg
  rw [cast_int_8] at hmem
  have hre := pos_re_of_CFpMem' S26_pos hmem hlo
  rw [atiyahDet_eq_stereoMat_div (x26Clamp 8) (x26Clamp_z_monotone 8), re_div_ofReal]
  exact div_pos hre (stereoDenR_pos (x26Clamp 8).1)

lemma atiyahDet_x26Clamp_10_re_neg : (atiyahDet (x26Clamp 10)).re < 0 := by
  have hg := gauss26_10_eq
  have hhi := Q10_25_re_neg
  have hmem := stereoMat_det_mem (by decide : (1 : ℤ) ≤ 10) rho10_ok hg
  rw [cast_int_10] at hmem
  have hre := neg_re_of_CFpMem' S26_pos hmem hhi
  rw [atiyahDet_eq_stereoMat_div (x26Clamp 10) (x26Clamp_z_monotone 10), re_div_ofReal]
  exact div_neg_of_neg_of_pos hre (stereoDenR_pos (x26Clamp 10).1)

end FinalSigns26

section MainTheorems26
attribute [local irreducible] atiyahDet

/-- Explicit non-coplanar `26`-point configuration (`t = 10`) with strictly negative real
Atiyah–Sutcliffe determinant and vanishing imaginary part. -/
theorem exists_noncoplanar_3d_26_atiyahDet_neg :
    ∃ x : DistinctPoints 26, Noncoplanar3D x.1 ∧ (atiyahDet x).re < 0 ∧ (atiyahDet x).im = 0 :=
  ⟨x26Clamp 10, x26Clamp_noncoplanar 10, atiyahDet_x26Clamp_10_re_neg,
    atiyahDet_x26Clamp_im_zero 10⟩

/-- Non-coplanar `26`-point configuration with vanishing Atiyah determinant, obtained by the
Intermediate Value Theorem along `t ↦ x26Clamp t` on `[8, 10]`. -/
theorem exists_noncoplanar_3d_26_atiyahDet_zero :
    ∃ x : DistinctPoints 26, Noncoplanar3D x.1 ∧ atiyahDet x = 0 := by
  let f : ℝ → ℝ := fun t => (atiyahDet (x26Clamp t)).re
  have hcont : ContinuousOn f (Set.Icc (8 : ℝ) 10) :=
    continuous_atiyahDet_x26Clamp_re.continuousOn
  have hfp : 0 < f 8 := atiyahDet_x26Clamp_8_re_pos
  have hfn : f 10 < 0 := atiyahDet_x26Clamp_10_re_neg
  have hmem : (0 : ℝ) ∈ Set.Icc (f 10) (f 8) := ⟨hfn.le, hfp.le⟩
  obtain ⟨t₀, _, ht₀⟩ := intermediate_value_Icc' (by norm_num : (8 : ℝ) ≤ 10) hcont hmem
  refine ⟨x26Clamp t₀, x26Clamp_noncoplanar t₀, ?_⟩
  exact Complex.ext ht₀ (atiyahDet_x26Clamp_im_zero t₀)

/-- **Disproof of Atiyah Conjecture 1 (determinant form)** at `n = 26`. -/
theorem disproof_atiyah_det_nonzero_3d_26 : ¬ AtiyahDetNonzeroProp := by
  intro h
  obtain ⟨x, _, hx⟩ := exists_noncoplanar_3d_26_atiyahDet_zero
  exact h 26 (by norm_num) x hx

/-- **Disproof of Atiyah Conjecture 1 (linear independence form)** at `n = 26`. -/
theorem disproof_atiyah_conjecture_1_3d_26 : ¬ AtiyahConjecture1Prop := by
  intro h
  obtain ⟨x, _, hx⟩ := exists_noncoplanar_3d_26_atiyahDet_zero
  exact not_linearIndependent_of_atiyahDet_eq_zero (by norm_num) x hx (h 26 (by norm_num) x)

/-- **Disproof of Atiyah–Sutcliffe Conjecture 2** at `n = 26`. -/
theorem disproof_atiyah_sutcliffe_conjecture_2_3d_26 : ¬ AtiyahSutcliffeConjecture2Prop := by
  intro h
  obtain ⟨x, _, hx⟩ := exists_noncoplanar_3d_26_atiyahDet_zero
  have hle := h 26 (by norm_num) x
  rw [hx, norm_zero] at hle
  linarith

end MainTheorems26

