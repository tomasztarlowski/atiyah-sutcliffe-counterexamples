module

public import Matematyka.AtiyahSutcliffeExtensions
public import Matematyka.AtiyahSutcliffe3D36

/-!
# Lean-certified non-coplanar 3D disproof of Atiyah–Sutcliffe Conjectures 1 & 2 at `n = 26`

A mirror-symmetric (`y ↦ -y`) family `x26Clamp t` of `26` distinct points in `ℝ³` with integer base
coordinates.  Kernel-checked complex interval arithmetic (certified complex Gaussian elimination on
the full `26 × 26` stereographic Atiyah matrix) shows `(atiyahDet (x26Clamp 8)).re > 0` and
`(atiyahDet (x26Clamp 10)).re < 0`; the reflection symmetry gives `(atiyahDet (x26Clamp t)).im = 0`
for all `t`, and the Intermediate Value Theorem yields a configuration with `atiyahDet = 0`.
-/

@[expose] public section

namespace Matematyka.AtiyahSutcliffe3D26

open Complex Real Matrix Polynomial
open Matematyka.MalkounCounterexample Matematyka.AtiyahSutcliffe Matematyka.AtiyahSutcliffe3D36

/-! ## Part 1: Complex interval division and certified complex Gaussian elimination -/

section ComplexGauss

/-- Fixed-point enclosure of `|z|²`. -/
def normSqIv (S : ℤ) (a : CFpIv) : FpIv :=
  FpIv.add (FpIv.mulFp S a.re a.re) (FpIv.mulFp S a.im a.im)

lemma normSqIv_mem {S : ℤ} (hS : 0 < S) {a : CFpIv} {z : ℂ} (hz : CFpIv.CFpMem S a z) :
    FpIv.FpMem S (normSqIv S a) (Complex.normSq z) := by
  rw [Complex.normSq_apply]
  exact FpIv.add_mem (FpIv.mulFp_mem hS hz.1 hz.1) (FpIv.mulFp_mem hS hz.2 hz.2)

/-- Outward-rounded complex division `a / b = a * conj b / |b|²`. -/
def cdivIv (S : ℤ) (a b : CFpIv) : CFpIv :=
  ⟨FpIv.divFp S (CFpIv.mul S a (CFpIv.conj b)).re (normSqIv S b),
   FpIv.divFp S (CFpIv.mul S a (CFpIv.conj b)).im (normSqIv S b)⟩

lemma cdivIv_mem {S : ℤ} (hS : 0 < S) {a b : CFpIv} {x y : ℂ}
    (hsep : 0 < (normSqIv S b).lo) (hx : CFpIv.CFpMem S a x) (hy : CFpIv.CFpMem S b y) :
    CFpIv.CFpMem S (cdivIv S a b) (x / y) := by
  have hn := normSqIv_mem hS hy
  have hnum := CFpIv.mul_mem hS hx (CFpIv.conj_mem hy)
  have hre : (x / y).re = (x * star y).re / Complex.normSq y := by
    rw [Complex.div_re]
    simp only [Complex.mul_re, Complex.star_def, Complex.conj_re, Complex.conj_im]
    ring
  have him : (x / y).im = (x * star y).im / Complex.normSq y := by
    rw [Complex.div_im]
    simp only [Complex.mul_im, Complex.star_def, Complex.conj_re, Complex.conj_im]
    ring
  refine ⟨?_, ?_⟩
  · change FpIv.FpMem S (FpIv.divFp S (CFpIv.mul S a (CFpIv.conj b)).re (normSqIv S b)) (x / y).re
    rw [hre]
    exact FpIv.divFp_mem hS (Or.inl hsep) hnum.1 hn
  · change FpIv.FpMem S (FpIv.divFp S (CFpIv.mul S a (CFpIv.conj b)).im (normSqIv S b)) (x / y).im
    rw [him]
    exact FpIv.divFp_mem hS (Or.inl hsep) hnum.2 hn

def isZeroCIv (a : CFpIv) : Bool := isZeroIv a.re && isZeroIv a.im

def isSepCIv (S : ℤ) (a : CFpIv) : Bool := decide (0 < (normSqIv S a).lo)

lemma eq_zero_of_isZeroCIv {S : ℤ} (hS : 0 < S) {iv : CFpIv} {z : ℂ}
    (hz : isZeroCIv iv = true) (hx : CFpIv.CFpMem S iv z) : z = 0 := by
  simp only [isZeroCIv, Bool.and_eq_true] at hz
  exact Complex.ext (eq_zero_of_isZeroIv hS hz.1 hx.1) (eq_zero_of_isZeroIv hS hz.2 hx.2)

lemma ne_zero_of_sepC {S : ℤ} (hS : 0 < S) {iv : CFpIv} {z : ℂ}
    (hsep : 0 < (normSqIv S iv).lo) (hx : CFpIv.CFpMem S iv z) : z ≠ 0 := by
  intro hz0
  have hn := normSqIv_mem hS hx
  rw [hz0, map_zero] at hn
  have h1 : ((normSqIv S iv).lo : ℝ) ≤ (S : ℝ) * 0 := hn.1
  have h2 : (0 : ℝ) < ((normSqIv S iv).lo : ℝ) := by exact_mod_cast hsep
  linarith

/-- Complex Schur-complement submatrix after eliminating column `0` using pivot `A 0 0`. -/
noncomputable def elimSubMatrixC {m : ℕ} (A : Matrix (Fin (m + 1)) (Fin (m + 1)) ℂ) :
    Matrix (Fin m) (Fin m) ℂ :=
  fun i j => A i.succ j.succ + (-(A i.succ 0) / A 0 0) * A 0 j.succ

lemma det_eq_head_mul_det_elimSubMatrixC {m : ℕ}
    (A : Matrix (Fin (m + 1)) (Fin (m + 1)) ℂ) (h0 : A 0 0 ≠ 0) :
    A.det = A 0 0 * (elimSubMatrixC A).det := by
  let clearUpTo : ℕ → Matrix (Fin (m + 1)) (Fin (m + 1)) ℂ := fun k r c =>
    if r = 0 then A 0 c
    else if r.1 ≤ k then A r c + (-(A r 0) / A 0 0) * A 0 c
    else A r c
  have hdet_clear : ∀ k : ℕ, (clearUpTo k).det = A.det := by
    intro k
    induction k with
    | zero =>
      have h0eq : clearUpTo 0 = A := by
        ext r c
        by_cases hr : r = 0
        · subst hr; simp [clearUpTo]
        · have hr1 : ¬ r.1 ≤ 0 := by
            intro hle
            exact hr (Fin.ext (Nat.le_zero.mp hle))
          simp [clearUpTo, hr, hr1]
      rw [h0eq]
    | succ k ih =>
      by_cases hk : k + 1 ≤ m
      · let r0 : Fin (m + 1) := ⟨k + 1, by omega⟩
        have hr0_ne : r0 ≠ 0 := by intro h; have := congr_arg Fin.val h; dsimp [r0] at this; omega
        let c : ℂ := -(A r0 0) / A 0 0
        have hupd : (clearUpTo k).updateRow r0 (clearUpTo k r0 + c • clearUpTo k 0) =
            clearUpTo (k + 1) := by
          ext r col
          by_cases hr : r = r0
          · subst hr
            have hnot : ¬ r0.1 ≤ k := by dsimp [r0]; omega
            have hle : r0.1 ≤ k + 1 := by dsimp [r0]; omega
            rw [congr_fun (Matrix.updateRow_self (M := clearUpTo k) (i := r0)
              (b := clearUpTo k r0 + c • clearUpTo k 0)) col]
            simp [clearUpTo, hr0_ne, hnot, hle, c]
          · rw [congr_fun (Matrix.updateRow_ne (M := clearUpTo k)
              (b := clearUpTo k r0 + c • clearUpTo k 0) hr) col]
            by_cases hrz : r = 0
            · simp [clearUpTo, hrz]
            · have hne1 : r.1 ≠ k + 1 := fun he => hr (Fin.ext he)
              have hiff : r.1 ≤ k + 1 ↔ r.1 ≤ k := by omega
              simp [clearUpTo, hrz, hiff]
        rw [← ih, ← hupd, Matrix.det_updateRow_add_smul_self _ hr0_ne]
      · have heq : clearUpTo (k + 1) = clearUpTo k := by
          ext r c
          by_cases hr : r = 0
          · simp [clearUpTo, hr]
          · have hlt : r.1 ≤ m := Nat.lt_succ_iff.mp r.2
            have hiff : r.1 ≤ k + 1 ↔ r.1 ≤ k := by omega
            simp [clearUpTo, hr, hiff]
        rw [heq, ih]
  let B := clearUpTo m
  have hBdet : B.det = A.det := hdet_clear m
  have hB0 : B 0 0 = A 0 0 := by simp [B, clearUpTo]
  have hBcol : ∀ i : Fin m, B i.succ 0 = 0 := by
    intro i
    have hne : i.succ ≠ 0 := Fin.succ_ne_zero i
    have hle : i.succ.1 ≤ m := Nat.lt_succ_iff.mp i.succ.2
    simp only [B, clearUpTo, hne, hle, ↓reduceIte]
    field_simp [h0]
    ring
  have hBsub : B.submatrix Fin.succ Fin.succ = elimSubMatrixC A := by
    ext i j
    have hne : i.succ ≠ 0 := Fin.succ_ne_zero i
    have hle : i.succ.1 ≤ m := Nat.lt_succ_iff.mp i.succ.2
    change B i.succ j.succ = elimSubMatrixC A i j
    simp only [B, clearUpTo, elimSubMatrixC, hne, hle, ↓reduceIte]
  rw [← hBdet, Matrix.det_succ_column_zero, Fin.sum_univ_succ]
  have htail : (∑ i : Fin m, (-1 : ℂ) ^ (i.succ : ℕ) * B i.succ 0 *
      (B.submatrix i.succ.succAbove Fin.succ).det) = 0 := by
    refine Finset.sum_eq_zero fun i _ => ?_
    simp [hBcol i]
  rw [htail, add_zero, Fin.val_zero, pow_zero, one_mul, hB0, Fin.succAbove_zero, hBsub]

/-- Row-wise fixed-point enclosure for fixed length `m`. -/
def RowCMem (S : ℤ) (m : ℕ) (row : List CFpIv) (v : Fin m → ℂ) : Prop :=
  row.length = m ∧ ∀ j : Fin m, CFpIv.CFpMem S (row.getD j.1 CFpIv.zero) (v j)

/-- Matrix fixed-point enclosure for fixed dimension `m × m`. -/
def MatCMem (S : ℤ) (m : ℕ) (rows : List (List CFpIv)) (A : Matrix (Fin m) (Fin m) ℂ) : Prop :=
  rows.length = m ∧ ∀ i : Fin m, RowCMem S m (rows.getD i.1 []) (A i)

def zipElimCIv (S : ℤ) (mult : CFpIv) : List CFpIv → List CFpIv → List CFpIv
  | r :: rs, p :: ps =>
    (if isZeroCIv p then r else CFpIv.add r (CFpIv.mul S mult p)) :: zipElimCIv S mult rs ps
  | _, _ => []

def elimRowsCIv (S : ℤ) (piv : CFpIv) (ptail : List CFpIv) : List (List CFpIv) → List (List CFpIv)
  | [] => []
  | row :: rows =>
    let rhead := row.headD CFpIv.zero
    let rtail := row.tail
    (if isZeroCIv rhead then rtail else zipElimCIv S (cdivIv S (CFpIv.neg rhead) piv) rtail ptail) ::
      elimRowsCIv S piv ptail rows

/-- Certified Gaussian elimination without row pivoting, returning `(ok, ∏ pivots)`. -/
def gaussDetCIv (S : ℤ) : ℕ → List (List CFpIv) → CFpIv → Bool × CFpIv
  | 0, _, prod => (true, prod)
  | m + 1, pRow :: rest, prod =>
    let piv := pRow.headD CFpIv.zero
    if isSepCIv S piv then
      gaussDetCIv S m (elimRowsCIv S piv pRow.tail rest) (CFpIv.mul S prod piv)
    else (false, prod)
  | _ + 1, [], prod => (false, prod)

private lemma rowCMem_tail {S : ℤ} {m : ℕ} {row : List CFpIv} {v : Fin (m + 1) → ℂ}
    (h : RowCMem S (m + 1) row v) :
    RowCMem S m row.tail (fun j => v j.succ) := by
  rcases h with ⟨hlen, hmem⟩
  cases row with
  | nil => simp at hlen
  | cons x xs =>
    refine ⟨by simp at hlen ⊢; exact hlen, fun j => ?_⟩
    simpa [List.tail_cons, List.getD_cons_succ] using hmem j.succ

private lemma rowCMem_zipElimCIv {S : ℤ} (hS : 0 < S) {m : ℕ}
    {rs ps : List CFpIv} {vr vp : Fin m → ℂ} {mult : CFpIv} {c : ℂ}
    (hrs : RowCMem S m rs vr) (hps : RowCMem S m ps vp) (hmult : CFpIv.CFpMem S mult c) :
    RowCMem S m (zipElimCIv S mult rs ps) (fun j => vr j + c * vp j) := by
  induction m generalizing rs ps with
  | zero =>
    rcases hrs with ⟨hrlen, _⟩
    rcases hps with ⟨hplen, _⟩
    cases rs <;> cases ps <;> simp at hrlen hplen
    exact ⟨rfl, fun j => j.elim0⟩
  | succ m ih =>
    rcases hrs with ⟨hrlen, hrmem⟩
    rcases hps with ⟨hplen, hpmem⟩
    cases rs with
    | nil => simp at hrlen
    | cons r rs =>
      cases ps with
      | nil => simp at hplen
      | cons p ps =>
        have ih_res := ih (vr := fun j => vr j.succ) (vp := fun j => vp j.succ)
          ⟨by simp at hrlen; exact hrlen, fun j => by simpa [List.getD_cons_succ] using hrmem j.succ⟩
          ⟨by simp at hplen; exact hplen, fun j => by simpa [List.getD_cons_succ] using hpmem j.succ⟩
        refine ⟨by simp [zipElimCIv, ih_res.1], fun j => ?_⟩
        refine Fin.cases ?_ (fun k => ?_) j
        · simp only [Fin.val_zero, zipElimCIv, List.getD_cons_zero]
          by_cases hzp : isZeroCIv p = true
          · have hp0 : vp 0 = 0 := eq_zero_of_isZeroCIv hS hzp (by simpa using hpmem 0)
            simp only [hzp, ↓reduceIte, hp0, mul_zero, add_zero]
            simpa using hrmem 0
          · simp only [hzp, Bool.false_eq_true, ↓reduceIte]
            exact CFpIv.add_mem (by simpa using hrmem 0)
              (CFpIv.mul_mem hS hmult (by simpa using hpmem 0))
        · simpa [zipElimCIv, List.getD_cons_succ] using ih_res.2 k

private lemma elimRowsCIv_length (S : ℤ) (piv : CFpIv) (ptail : List CFpIv)
    (rows : List (List CFpIv)) :
    (elimRowsCIv S piv ptail rows).length = rows.length := by
  induction rows with
  | nil => rfl
  | cons row rows ih => simp [elimRowsCIv, ih]

private lemma elimRowsCIv_getD {S : ℤ} {piv : CFpIv} {ptail : List CFpIv}
    {rows : List (List CFpIv)} {k : ℕ} (hk : k < rows.length) :
    (elimRowsCIv S piv ptail rows).getD k [] =
      let row := rows.getD k []
      let rhead := row.headD CFpIv.zero
      let rtail := row.tail
      if isZeroCIv rhead then rtail
      else zipElimCIv S (cdivIv S (CFpIv.neg rhead) piv) rtail ptail := by
  induction rows generalizing k with
  | nil => simp at hk
  | cons row rows ih =>
    cases k with
    | zero => simp [elimRowsCIv]
    | succ k =>
      simp only [List.length_cons, Nat.succ_lt_succ_iff] at hk
      simpa [elimRowsCIv, List.getD_cons_succ] using ih hk

lemma matCMem_elimSubMatrixC {S : ℤ} (hS : 0 < S) {m : ℕ}
    {pRow : List CFpIv} {rest : List (List CFpIv)} {A : Matrix (Fin (m + 1)) (Fin (m + 1)) ℂ}
    (hmat : MatCMem S (m + 1) (pRow :: rest) A)
    (hpiv_sep : isSepCIv S (pRow.headD CFpIv.zero) = true) :
    MatCMem S m (elimRowsCIv S (pRow.headD CFpIv.zero) pRow.tail rest) (elimSubMatrixC A) := by
  rcases hmat with ⟨hlen, hrow⟩
  have hrest_len : rest.length = m := by simpa using hlen
  have hpRow_mem : RowCMem S (m + 1) pRow (A 0) := by simpa using hrow 0
  have hpiv_mem : CFpIv.CFpMem S (pRow.headD CFpIv.zero) (A 0 0) := by
    cases pRow with
    | nil => have := hpRow_mem.1; simp at this
    | cons x xs => simpa using hpRow_mem.2 0
  have hptail_mem := rowCMem_tail hpRow_mem
  have hsep : 0 < (normSqIv S (pRow.headD CFpIv.zero)).lo := of_decide_eq_true hpiv_sep
  refine ⟨by rw [elimRowsCIv_length, hrest_len], fun i => ?_⟩
  rw [elimRowsCIv_getD (by rw [hrest_len]; exact i.2)]
  have hi_mem : RowCMem S (m + 1) (rest.getD i.1 []) (A i.succ) := by
    simpa [List.getD_cons_succ] using hrow i.succ
  have hrhead_mem : CFpIv.CFpMem S ((rest.getD i.1 []).headD CFpIv.zero) (A i.succ 0) := by
    cases hri : rest.getD i.1 [] with
    | nil => have hl := hi_mem.1; rw [hri] at hl; simp at hl
    | cons x xs =>
      have h0 := hi_mem.2 0
      rw [hri] at h0
      simpa using h0
  have hrtail_mem := rowCMem_tail hi_mem
  dsimp only
  by_cases hzero : isZeroCIv ((rest.getD i.1 []).headD CFpIv.zero) = true
  · simp only [hzero, ↓reduceIte]
    have hA0 : A i.succ 0 = 0 := eq_zero_of_isZeroCIv hS hzero hrhead_mem
    have heq : elimSubMatrixC A i = (fun j => A i.succ j.succ) := by
      ext j; simp [elimSubMatrixC, hA0]
    rw [heq]
    exact hrtail_mem
  · simp only [hzero, Bool.false_eq_true, ↓reduceIte]
    have hdiv_mem : CFpIv.CFpMem S (cdivIv S (CFpIv.neg ((rest.getD i.1 []).headD CFpIv.zero))
        (pRow.headD CFpIv.zero)) (-(A i.succ 0) / A 0 0) :=
      cdivIv_mem hS hsep (CFpIv.neg_mem hrhead_mem) hpiv_mem
    exact rowCMem_zipElimCIv hS hrtail_mem hptail_mem hdiv_mem

theorem gaussDetCIv_mem {S : ℤ} (hS : 0 < S) :
    ∀ {m : ℕ} {rows : List (List CFpIv)} {A : Matrix (Fin m) (Fin m) ℂ} {prod out : CFpIv} {p₀ : ℂ},
      gaussDetCIv S m rows prod = (true, out) →
      CFpIv.CFpMem S prod p₀ →
      MatCMem S m rows A →
      CFpIv.CFpMem S out (p₀ * A.det) := by
  intro m
  induction m with
  | zero =>
    intro rows A prod out p₀ hres hp₀ _
    simp only [gaussDetCIv, Prod.mk.injEq, true_and] at hres
    subst hres
    have hdet : A.det = 1 := Matrix.det_isEmpty
    simpa [hdet] using hp₀
  | succ m ih =>
    intro rows A prod out p₀ hres hp₀ hmat
    cases rows with
    | nil =>
      have hlen := hmat.1; simp at hlen
    | cons pRow rest =>
      dsimp only [gaussDetCIv] at hres
      by_cases hpiv : isSepCIv S (pRow.headD CFpIv.zero) = true
      · simp only [hpiv, ↓reduceIte] at hres
        have hpRow_mem : RowCMem S (m + 1) pRow (A 0) := by simpa using hmat.2 0
        have hpiv_mem : CFpIv.CFpMem S (pRow.headD CFpIv.zero) (A 0 0) := by
          cases pRow with
          | nil => have := hpRow_mem.1; simp at this
          | cons x xs => simpa using hpRow_mem.2 0
        have hA00_ne : A 0 0 ≠ 0 := ne_zero_of_sepC hS (of_decide_eq_true hpiv) hpiv_mem
        have hstep := ih hres (CFpIv.mul_mem hS hp₀ hpiv_mem)
          (matCMem_elimSubMatrixC hS hmat hpiv)
        rw [mul_assoc, ← det_eq_head_mul_det_elimSubMatrixC A hA00_ne] at hstep
        exact hstep
      · simp only [hpiv, Bool.false_eq_true, ↓reduceIte, Prod.mk.injEq] at hres
        exact False.elim hres.1

end ComplexGauss
/-! ## Part 2: The mirror-symmetric `n = 26` family `x26Clamp`, reality and continuity -/

section X26Family

def x26BaseArr : List (ℤ × ℤ × ℤ) := [
  (-65, 0, 0), (-76, 0, 36), (-105, 0, 65), (-53, 0, 247),
  (-23, 0, 994), (8, 0, 1537), (-275, -234, 1778), (-275, 234, 1778),
  (37, -23, 2189), (37, 23, 2189), (100, 0, 3124), (26, -47, 3221),
  (26, 47, 3221), (45, 0, 3314), (-7, -5, 3318), (-7, 5, 3318),
  (5, -14, 3377), (5, 14, 3377), (-5, 0, 3390), (0, -5, 3412),
  (0, 5, 3412), (-1, 0, 3421), (15, 0, 3423), (0, 0, 3430),
  (-385, -360, 3467), (-385, 360, 3467)]

def x26BaseX (i : Fin 26) : ℤ := (x26BaseArr.getD i.1 (0, 0, 0)).1
def x26BaseY (i : Fin 26) : ℤ := (x26BaseArr.getD i.1 (0, 0, 0)).2.1
def x26BaseZ (i : Fin 26) : ℤ := (x26BaseArr.getD i.1 (0, 0, 0)).2.2

lemma x26BaseZ_monotone : Monotone x26BaseZ := by decide

lemma x26Base_distinct : ∀ i j : Fin 26, i ≠ j →
    x26BaseZ i ≠ x26BaseZ j ∨ x26BaseX i ≠ x26BaseX j ∨ x26BaseY i ≠ x26BaseY j := by
  decide

noncomputable def x26ClampRaw (t : ℝ) (i : Fin 26) : Fin 3 → ℝ :=
  ![(max t 1) * (x26BaseX i : ℝ), (max t 1) * (x26BaseY i : ℝ), (x26BaseZ i : ℝ)]

noncomputable def x26Clamp (t : ℝ) : DistinctPoints 26 :=
  ⟨x26ClampRaw t, by
    intro i j hij hEq
    have hs : max t 1 ≠ 0 := by linarith [le_max_right t (1 : ℝ)]
    have h0 : max t 1 * (x26BaseX i : ℝ) = max t 1 * (x26BaseX j : ℝ) := by
      simpa [x26ClampRaw] using congrFun hEq 0
    have h1 : max t 1 * (x26BaseY i : ℝ) = max t 1 * (x26BaseY j : ℝ) := by
      simpa [x26ClampRaw] using congrFun hEq 1
    have h2 : (x26BaseZ i : ℝ) = (x26BaseZ j : ℝ) := by
      simpa [x26ClampRaw] using congrFun hEq 2
    have hx : x26BaseX i = x26BaseX j := Int.cast_injective (mul_left_cancel₀ hs h0)
    have hy : x26BaseY i = x26BaseY j := Int.cast_injective (mul_left_cancel₀ hs h1)
    have hz : x26BaseZ i = x26BaseZ j := Int.cast_injective h2
    rcases x26Base_distinct i j hij with h | h | h
    · exact h hz
    · exact h hx
    · exact h hy⟩

lemma x26Clamp_z_monotone (t : ℝ) : Monotone (fun i => (x26Clamp t).1 i 2) := by
  intro i j hij
  exact Int.cast_le.mpr (x26BaseZ_monotone hij)


def reflectPerm26 : Equiv.Perm (Fin 26) :=
  Equiv.swap ⟨6, by decide⟩ ⟨7, by decide⟩ *
    Equiv.swap ⟨8, by decide⟩ ⟨9, by decide⟩ *
    Equiv.swap ⟨11, by decide⟩ ⟨12, by decide⟩ *
    Equiv.swap ⟨14, by decide⟩ ⟨15, by decide⟩ *
    Equiv.swap ⟨16, by decide⟩ ⟨17, by decide⟩ *
    Equiv.swap ⟨19, by decide⟩ ⟨20, by decide⟩ *
    Equiv.swap ⟨24, by decide⟩ ⟨25, by decide⟩

lemma x26Base_reflect : ∀ i : Fin 26,
    x26BaseX (reflectPerm26 i) = x26BaseX i ∧
      x26BaseY (reflectPerm26 i) = -x26BaseY i ∧
      x26BaseZ (reflectPerm26 i) = x26BaseZ i := by
  decide

lemma atiyahDet_x26Clamp_im_zero (t : ℝ) : (atiyahDet (x26Clamp t)).im = 0 := by
  let x := x26Clamp t
  let q := permPoints x reflectPerm26
  have hperm : atiyahDet q = atiyahDet x := atiyahDet_perm x reflectPerm26
  have hqz : Monotone (fun i => q.1 i 2) := by
    intro i j hij
    change (x26Clamp t).1 (reflectPerm26 i) 2 ≤ (x26Clamp t).1 (reflectPerm26 j) 2
    have hzi : (x26Clamp t).1 (reflectPerm26 i) 2 = (x26BaseZ (reflectPerm26 i) : ℝ) := rfl
    have hzj : (x26Clamp t).1 (reflectPerm26 j) 2 = (x26BaseZ (reflectPerm26 j) : ℝ) := rfl
    rw [hzi, hzj, (x26Base_reflect i).2.2, (x26Base_reflect j).2.2]
    exact x26Clamp_z_monotone t hij
  have hslope : ∀ i j : Fin 26, stereoSlope q.1 i j = star (stereoSlope x.1 i j) := by
    intro i j
    have hq0i : q.1 i 0 = x.1 i 0 := by
      simp [q, x, permPoints, x26Clamp, x26ClampRaw, (x26Base_reflect i).1]
    have hq0j : q.1 j 0 = x.1 j 0 := by
      simp [q, x, permPoints, x26Clamp, x26ClampRaw, (x26Base_reflect j).1]
    have hq1i : q.1 i 1 = -x.1 i 1 := by
      simp [q, x, permPoints, x26Clamp, x26ClampRaw, (x26Base_reflect i).2.1]
    have hq1j : q.1 j 1 = -x.1 j 1 := by
      simp [q, x, permPoints, x26Clamp, x26ClampRaw, (x26Base_reflect j).2.1]
    have hq2i : q.1 i 2 = x.1 i 2 := by
      simp [q, x, permPoints, x26Clamp, x26ClampRaw, (x26Base_reflect i).2.2]
    have hq2j : q.1 j 2 = x.1 j 2 := by
      simp [q, x, permPoints, x26Clamp, x26ClampRaw, (x26Base_reflect j).2.2]
    have hden : stereoDenomR (q.1 i) (q.1 j) = stereoDenomR (x.1 i) (x.1 j) := by
      unfold stereoDenomR euclidNorm
      have hsq : (q.1 j 0 - q.1 i 0) ^ 2 + (q.1 j 1 - q.1 i 1) ^ 2 + (q.1 j 2 - q.1 i 2) ^ 2 =
          (x.1 j 0 - x.1 i 0) ^ 2 + (x.1 j 1 - x.1 i 1) ^ 2 + (x.1 j 2 - x.1 i 2) ^ 2 := by
        rw [hq0i, hq0j, hq1i, hq1j, hq2i, hq2j]; ring
      rw [hq2i, hq2j, hsq]
    unfold stereoSlope
    rw [hden, hq0i, hq0j, hq1i, hq1j]
    have hsub1 : (-x.1 j 1 - -x.1 i 1 : ℝ) = -(x.1 j 1 - x.1 i 1) := by ring
    rw [hsub1]
    simp [Complex.conj_ofReal, sub_eq_add_neg]
    ring
  have hsp : ∀ i j k, stereoSpinor q.1 i j k = starRingEnd ℂ (stereoSpinor x.1 i j k) := by
    intro i j k
    unfold stereoSpinor
    split_ifs <;> fin_cases k <;> simp [hslope, map_neg]
  have hpoly : ∀ i : Fin 26,
      atiyahPoly (stereoSpinor q.1) i = (atiyahPoly (stereoSpinor x.1) i).map (starRingEnd ℂ) := by
    intro i
    simp only [atiyahPoly, Polynomial.map_prod, Polynomial.map_add, Polynomial.map_mul,
      Polynomial.map_C, Polynomial.map_X]
    refine Finset.prod_congr rfl fun j _ => ?_
    simp [hsp i j 0, hsp i j 1]
  have hmat :
      atiyahMat (stereoSpinor q.1) = (starRingEnd ℂ).mapMatrix (atiyahMat (stereoSpinor x.1)) := by
    ext i k
    simp [atiyahMat, hpoly i, Polynomial.coeff_map]
  have hdenR : stereoDenR q.1 = stereoDenR x.1 := by
    refine Finset.prod_congr rfl fun e _ => ?_
    rw [hslope e.1.1 e.1.2]
    simp [Complex.normSq_apply]
  have hdet_star : atiyahDet q = starRingEnd ℂ (atiyahDet x) := by
    rw [atiyahDet_eq_stereoMat_div q hqz, atiyahDet_eq_stereoMat_div x (x26Clamp_z_monotone t),
      hmat, hdenR, ← RingHom.map_det (starRingEnd ℂ)]
    simp [Complex.conj_ofReal]
  have hself : starRingEnd ℂ (atiyahDet x) = atiyahDet x := hdet_star.symm.trans hperm
  have him := congrArg Complex.im hself
  simp at him
  linarith

private lemma continuous_poly_coeff_of_continuous {n : ℕ}
    {c0 c1 : ℝ → Fin n → ℂ}
    (hc0 : ∀ j, Continuous (fun t => c0 t j))
    (hc1 : ∀ j, Continuous (fun t => c1 t j)) :
    ∀ (S : Finset (Fin n)) (k : ℕ),
      Continuous (fun t => (∏ j ∈ S, (Polynomial.C (c0 t j) + Polynomial.C (c1 t j) * Polynomial.X)).coeff k) := by
  classical
  intro S
  induction S using Finset.induction_on with
  | empty =>
    intro k
    simp only [Finset.prod_empty, Polynomial.coeff_one]
    exact continuous_const
  | insert a s ha ih =>
    intro k
    have heq :
        (fun t => (∏ j ∈ insert a s,
            (Polynomial.C (c0 t j) + Polynomial.C (c1 t j) * Polynomial.X)).coeff k) =
          fun t => ∑ m ∈ Finset.HasAntidiagonal.antidiagonal k,
            ((Polynomial.C (c0 t a) + Polynomial.C (c1 t a) * Polynomial.X).coeff m.1) *
              ((∏ j ∈ s, (Polynomial.C (c0 t j) + Polynomial.C (c1 t j) * Polynomial.X)).coeff m.2) := by
      ext t
      rw [Finset.prod_insert ha, Polynomial.coeff_mul]
    rw [heq]
    have hterm : ∀ m ∈ Finset.HasAntidiagonal.antidiagonal k, Continuous fun t =>
        ((Polynomial.C (c0 t a) + Polynomial.C (c1 t a) * Polynomial.X).coeff m.1) *
          ((∏ j ∈ s, (Polynomial.C (c0 t j) + Polynomial.C (c1 t j) * Polynomial.X)).coeff m.2) := by
      intro m _
      refine Continuous.mul ?_ (ih m.2)
      rcases m with ⟨m1, m2⟩
      rcases m1 with _ | _ | m1'
      · simp only [Polynomial.coeff_add, Polynomial.coeff_C_zero, Polynomial.coeff_mul_X_zero, add_zero]
        exact hc0 a
      · simp only [Polynomial.coeff_add, Polynomial.coeff_C_succ, zero_add,
          Polynomial.coeff_mul_X, Polynomial.coeff_C_zero]
        exact hc1 a
      · simp only [Polynomial.coeff_add, Polynomial.coeff_C_succ, zero_add,
          Polynomial.coeff_mul_X]
        exact continuous_const
    fun_prop

private lemma stereoSlope_x26Clamp_continuous (i j : Fin 26) (hij : i < j) :
    Continuous (fun t : ℝ => stereoSlope (x26Clamp t).1 i j) := by
  let fx : ℝ → ℝ := fun t => max t 1 * ((x26BaseX j : ℝ) - (x26BaseX i : ℝ))
  let fy : ℝ → ℝ := fun t => max t 1 * ((x26BaseY j : ℝ) - (x26BaseY i : ℝ))
  let dz : ℝ := (x26BaseZ j : ℝ) - (x26BaseZ i : ℝ)
  have hmax : Continuous (fun t : ℝ => max t 1) := continuous_id.max continuous_const
  have hfx : Continuous fx := hmax.mul continuous_const
  have hfy : Continuous fy := hmax.mul continuous_const
  have heq : (fun t : ℝ => stereoSlope (x26Clamp t).1 i j) =
      fun t => ((fx t : ℂ) + Complex.I * (fy t : ℂ)) /
        ((dz + Real.sqrt (fx t ^ 2 + fy t ^ 2 + dz ^ 2) : ℝ) : ℂ) := by
    ext t
    have h0 : (x26Clamp t).1 j 0 - (x26Clamp t).1 i 0 = fx t := by
      simp [x26Clamp, x26ClampRaw, fx]; ring
    have h1 : (x26Clamp t).1 j 1 - (x26Clamp t).1 i 1 = fy t := by
      simp [x26Clamp, x26ClampRaw, fy]; ring
    have h2 : (x26Clamp t).1 j 2 - (x26Clamp t).1 i 2 = dz := rfl
    simp only [stereoSlope, stereoDenomR, euclidNorm, h0, h1, h2]
  rw [heq]
  have hnum : Continuous (fun t : ℝ => (fx t : ℂ) + Complex.I * (fy t : ℂ)) :=
    (Complex.continuous_ofReal.comp hfx).add
      (continuous_const.mul (Complex.continuous_ofReal.comp hfy))
  have hden : Continuous (fun t : ℝ => ((dz + Real.sqrt (fx t ^ 2 + fy t ^ 2 + dz ^ 2) : ℝ) : ℂ)) :=
    Complex.continuous_ofReal.comp
      (continuous_const.add (((hfx.pow 2).add (hfy.pow 2)).add continuous_const).sqrt)
  refine hnum.div hden fun t => Complex.ofReal_ne_zero.mpr ?_
  have hr : 0 < Real.sqrt (fx t ^ 2 + fy t ^ 2 + dz ^ 2) := by
    have h0 : (x26Clamp t).1 j 0 - (x26Clamp t).1 i 0 = fx t := by
      simp [x26Clamp, x26ClampRaw, fx]; ring
    have h1 : (x26Clamp t).1 j 1 - (x26Clamp t).1 i 1 = fy t := by
      simp [x26Clamp, x26ClampRaw, fy]; ring
    have h2 : (x26Clamp t).1 j 2 - (x26Clamp t).1 i 2 = dz := rfl
    have heu : 0 < euclidNorm (fun k => (x26Clamp t).1 j k - (x26Clamp t).1 i k) :=
      euclidNorm_pos_of_ne ((x26Clamp t).2 i j hij.ne)
    simpa [euclidNorm, h0, h1, h2] using heu
  have hdz_nn : 0 ≤ dz := sub_nonneg.mpr (x26Clamp_z_monotone t hij.le)
  linarith

private lemma continuous_finset_prod_aux {α β ι : Type*} [TopologicalSpace α]
    [CommMonoid β] [TopologicalSpace β] [ContinuousMul β]
    (s : Finset ι) {f : ι → α → β} (hf : ∀ i ∈ s, Continuous (f i)) :
    Continuous (fun a => ∏ i ∈ s, f i a) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using continuous_const
  | insert i s hi ih =>
    have h1 : Continuous (f i) := hf i (Finset.mem_insert_self i s)
    have h2 : Continuous (fun a => ∏ j ∈ s, f j a) :=
      ih (fun j hj => hf j (Finset.mem_insert_of_mem hj))
    have heq : (fun a => ∏ j ∈ insert i s, f j a) = fun a => f i a * ∏ j ∈ s, f j a :=
      funext fun a => Finset.prod_insert hi
    rw [heq]
    exact h1.mul h2

private lemma continuous_stereoMat_x26Clamp_det_re :
    Continuous (fun t : ℝ => ((atiyahMat (stereoSpinor (x26Clamp t).1)).det).re) := by
  have hspinor_cont : ∀ i j : Fin 26, ∀ m : Fin 2,
      Continuous (fun t : ℝ => stereoSpinor (x26Clamp t).1 i j m) := by
    intro i j m
    by_cases hij : i = j
    · simp only [stereoSpinor, hij, ↓reduceIte]
      exact continuous_const
    · by_cases hlt : i < j
      · simp only [stereoSpinor, hij, ↓reduceIte, hlt]
        fin_cases m
        · exact continuous_const
        · exact stereoSlope_x26Clamp_continuous i j hlt
      · have hgt : j < i := lt_of_le_of_ne (not_lt.mp hlt) (Ne.symm hij)
        simp only [stereoSpinor, hij, ↓reduceIte, hlt]
        fin_cases m
        · exact continuous_neg.comp (Complex.continuous_conj.comp (stereoSlope_x26Clamp_continuous j i hgt))
        · exact continuous_const
  have hmat_cont : ∀ i k : Fin 26,
      Continuous (fun t : ℝ => atiyahMat (stereoSpinor (x26Clamp t).1) i k) := by
    intro i k
    simpa [atiyahMat, atiyahPoly] using
      continuous_poly_coeff_of_continuous
        (c0 := fun t j => stereoSpinor (x26Clamp t).1 i j 0)
        (c1 := fun t j => stereoSpinor (x26Clamp t).1 i j 1)
        (fun j => hspinor_cont i j 0) (fun j => hspinor_cont i j 1)
        (Finset.univ.erase i) k.1
  exact Complex.continuous_re.comp
    (Continuous.matrix_det (continuous_pi fun i => continuous_pi fun k => hmat_cont i k))

private lemma continuous_stereoDenR_x26Clamp :
    Continuous (fun t : ℝ => stereoDenR (x26Clamp t).1) := by
  have hfac : ∀ e : { p : Fin 26 × Fin 26 // p.1 < p.2 }, Continuous fun t : ℝ =>
      1 + ((stereoSlope (x26Clamp t).1 e.1.1 e.1.2).re ^ 2 +
        (stereoSlope (x26Clamp t).1 e.1.1 e.1.2).im ^ 2) :=
    fun e => continuous_const.add
      (((Complex.continuous_re.comp (stereoSlope_x26Clamp_continuous e.1.1 e.1.2 e.2)).pow 2).add
        ((Complex.continuous_im.comp (stereoSlope_x26Clamp_continuous e.1.1 e.1.2 e.2)).pow 2))
  have hns : (fun t : ℝ => stereoDenR (x26Clamp t).1) =
      fun t => ∏ e : { p : Fin 26 × Fin 26 // p.1 < p.2 },
        (1 + ((stereoSlope (x26Clamp t).1 e.1.1 e.1.2).re ^ 2 +
          (stereoSlope (x26Clamp t).1 e.1.1 e.1.2).im ^ 2)) := by
    ext t
    unfold stereoDenR
    refine Finset.prod_congr rfl fun e _ => ?_
    simp [Complex.normSq_apply]; ring
  rw [hns]
  exact continuous_finset_prod_aux Finset.univ (fun e _ => hfac e)

section
attribute [local irreducible] Matrix.det stereoDenR

lemma continuous_atiyahDet_x26Clamp_re :
    Continuous (fun t : ℝ => (atiyahDet (x26Clamp t)).re) := by
  have hformula : (fun t : ℝ => (atiyahDet (x26Clamp t)).re) =
      fun t => ((atiyahMat (stereoSpinor (x26Clamp t).1)).det).re / stereoDenR (x26Clamp t).1 := by
    ext t
    rw [atiyahDet_eq_stereoMat_div (x26Clamp t) (x26Clamp_z_monotone t)]
    have hdiv : ∀ (z : ℂ) (r : ℝ), (z / (r : ℂ)).re = z.re / r := by
      intro z r
      by_cases hr : r = 0
      · subst hr; simp
      · simp [div_eq_mul_inv, ← Complex.ofReal_inv]
    exact hdiv _ _
  rw [hformula]
  have hdet_cont : Continuous (fun t : ℝ => ((atiyahMat (stereoSpinor (x26Clamp t).1)).det).re) :=
    continuous_stereoMat_x26Clamp_det_re
  have hden_cont : Continuous (fun t : ℝ => stereoDenR (x26Clamp t).1) :=
    continuous_stereoDenR_x26Clamp
  have hden_ne : ∀ t : ℝ, stereoDenR (x26Clamp t).1 ≠ 0 :=
    fun t => (stereoDenR_pos (x26Clamp t).1).ne'
  exact Continuous.div hdet_cont hden_cont hden_ne

end

