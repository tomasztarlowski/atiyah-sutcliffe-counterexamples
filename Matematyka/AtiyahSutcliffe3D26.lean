def pts26OfSn (sn : ℤ) (i : Fin 26) : Fin 3 → ℤ := fun k =>
  match k.1 with
  | 0 => sn * x26BaseX i
  | 1 => sn * x26BaseY i
  | _ => x26BaseZ i

private lemma x26Clamp_int_coords {sn : ℤ} (hsn : 1 ≤ sn) (i : Fin 26) (k : Fin 3) :
    (x26Clamp (sn : ℝ)).1 i k = ((pts26OfSn sn i k : ℤ) : ℝ) := by
  have hs : (1 : ℝ) ≤ (sn : ℝ) := by exact_mod_cast hsn
  have hmax : max (sn : ℝ) 1 = (sn : ℝ) := max_eq_left hs
  fin_cases k <;> simp [x26Clamp, x26ClampRaw, pts26OfSn, hmax]

def rhoTableOk26 (pts : Fin 26 → Fin 3 → ℤ) (tbl : List ℤ) : Bool :=
  tbl.length == 676 &&
    (List.finRange 26).all fun i =>
      (List.finRange 26).all fun j =>
        if i < j then
          let dx := pts j 0 - pts i 0
          let dy := pts j 1 - pts i 1
          let dz := pts j 2 - pts i 2
          if dx != 0 || dy != 0 then
            let r := tbl.getD (slot26 i.1 j.1) 0
            let n2 := S26 * S26 * (dx * dx + dy * dy + dz * dz)
            (0 < r) && (r * r ≤ n2) && (n2 ≤ (r + 1) * (r + 1))
          else true
        else true

private lemma rhoTableOk26_spec {pts : Fin 26 → Fin 3 → ℤ} {tbl : List ℤ}
    (hok : rhoTableOk26 pts tbl = true) {i j : Fin 26} (hij : i < j)
    (hne : pts j 0 - pts i 0 ≠ 0 ∨ pts j 1 - pts i 1 ≠ 0) :
    let r := tbl.getD (slot26 i.1 j.1) 0
    let dx := pts j 0 - pts i 0
    let dy := pts j 1 - pts i 1
    let dz := pts j 2 - pts i 2
    0 < r ∧ r * r ≤ S26 * S26 * (dx * dx + dy * dy + dz * dz) ∧
      S26 * S26 * (dx * dx + dy * dy + dz * dz) ≤ (r + 1) * (r + 1) := by
  simp only [rhoTableOk26, Bool.and_eq_true, List.all_eq_true] at hok
  have hi := hok.2 i (List.mem_finRange i) j (List.mem_finRange j)
  simp only [hij, ↓reduceIte] at hi
  have hcond : (pts j 0 - pts i 0 != 0 || pts j 1 - pts i 1 != 0) = true := by
    rcases hne with h | h <;> simp [h]
  simp only [hcond, ↓reduceIte, Bool.and_eq_true, decide_eq_true_eq] at hi
  exact ⟨hi.1.1, hi.1.2, hi.2⟩

def mkWEntry26 (pts : Fin 26 → Fin 3 → ℤ) (tbl : List ℤ) (i j : Fin 26) : CFpIv :=
  if j ≤ i then CFpIv.zero
  else
    let dx := pts j 0 - pts i 0
    let dy := pts j 1 - pts i 1
    let dz := pts j 2 - pts i 2
    if dx = 0 ∧ dy = 0 then CFpIv.zero
    else CFpIv.cslopeIv S26 dx dy dz (tbl.getD (slot26 i.1 j.1) 0)

private lemma mkWEntry26_mem {sn : ℤ} (hsn : 1 ≤ sn) {tbl : List ℤ}
    (hok : rhoTableOk26 (pts26OfSn sn) tbl = true) (i j : Fin 26) (hij : i < j) :
    CFpIv.CFpMem S26 (mkWEntry26 (pts26OfSn sn) tbl i j) (stereoSlope (x26Clamp (sn : ℝ)).1 i j) := by
  have hnot_ji : ¬ j ≤ i := not_le_of_gt hij
  have hc0i := x26Clamp_int_coords hsn i 0
  have hc0j := x26Clamp_int_coords hsn j 0
  have hc1i := x26Clamp_int_coords hsn i 1
  have hc1j := x26Clamp_int_coords hsn j 1
  have hc2i := x26Clamp_int_coords hsn i 2
  have hc2j := x26Clamp_int_coords hsn j 2
  set dx := pts26OfSn sn j 0 - pts26OfSn sn i 0
  set dy := pts26OfSn sn j 1 - pts26OfSn sn i 1
  set dz := pts26OfSn sn j 2 - pts26OfSn sn i 2
  have hdz_nn : 0 ≤ dz := by
    have hz := x26BaseZ_monotone hij.le
    change 0 ≤ x26BaseZ j - x26BaseZ i
    omega
  by_cases hxy : dx = 0 ∧ dy = 0
  · have hif : mkWEntry26 (pts26OfSn sn) tbl i j = CFpIv.zero := by
      change (if j ≤ i then CFpIv.zero else if dx = 0 ∧ dy = 0 then CFpIv.zero
        else CFpIv.cslopeIv S26 dx dy dz (tbl.getD (slot26 i.1 j.1) 0)) = CFpIv.zero
      simp only [hnot_ji, hxy, and_self, ↓reduceIte]
    rw [hif]
    have hdx0 : (x26Clamp (sn : ℝ)).1 j 0 - (x26Clamp (sn : ℝ)).1 i 0 = 0 := by
      rw [hc0i, hc0j]; exact_mod_cast hxy.1
    have hdy0 : (x26Clamp (sn : ℝ)).1 j 1 - (x26Clamp (sn : ℝ)).1 i 1 = 0 := by
      rw [hc1i, hc1j]; exact_mod_cast hxy.2
    have hslope0 : stereoSlope (x26Clamp (sn : ℝ)).1 i j = 0 := by
      unfold stereoSlope; rw [hdx0, hdy0]; simp
    rw [hslope0]
    exact CFpIv.zero_mem S26
  · have hif : mkWEntry26 (pts26OfSn sn) tbl i j =
        CFpIv.cslopeIv S26 dx dy dz (tbl.getD (slot26 i.1 j.1) 0) := by
      change (if j ≤ i then CFpIv.zero else if dx = 0 ∧ dy = 0 then CFpIv.zero
        else CFpIv.cslopeIv S26 dx dy dz (tbl.getD (slot26 i.1 j.1) 0)) = _
      simp only [hnot_ji, hxy, ↓reduceIte]
    rw [hif]
    have hne : dx ≠ 0 ∨ dy ≠ 0 := not_and_or.mp hxy
    have hspec := rhoTableOk26_spec hok hij hne
    have hrb := sqrt_rho_bounds S26_pos hspec.1 hspec.2.1 hspec.2.2
    have hcmem := @CFpIv.cslopeIv_mem S26 dx dy dz (tbl.getD (slot26 i.1 j.1) 0)
      (Real.sqrt ((dx : ℝ) ^ 2 + (dy : ℝ) ^ 2 + (dz : ℝ) ^ 2)) S26_pos hdz_nn hspec.1 hrb
    have heuclid :
        euclidNorm (fun k => (x26Clamp (sn : ℝ)).1 j k - (x26Clamp (sn : ℝ)).1 i k) =
          Real.sqrt ((dx : ℝ) ^ 2 + (dy : ℝ) ^ 2 + (dz : ℝ) ^ 2) := by
      unfold euclidNorm
      dsimp only
      rw [hc0i, hc0j, hc1i, hc1j, hc2i, hc2j]
      simp [dx, dy, dz, Int.cast_sub]
    have hsl_eq :
        stereoSlope (x26Clamp (sn : ℝ)).1 i j =
          (((dx : ℂ) + Complex.I * (dy : ℂ)) /
            ((dz : ℂ) + (Real.sqrt ((dx : ℝ) ^ 2 + (dy : ℝ) ^ 2 + (dz : ℝ) ^ 2) : ℂ))) := by
      unfold stereoSlope stereoDenomR
      rw [heuclid, hc0i, hc0j, hc1i, hc1j, hc2i, hc2j]
      simp [dx, dy, dz, Int.cast_sub]
    rw [hsl_eq]
    exact hcmem

