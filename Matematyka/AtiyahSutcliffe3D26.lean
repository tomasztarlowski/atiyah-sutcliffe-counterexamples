private lemma scaleListCIv_length (S : ℤ) (c : CFpIv) (l : List CFpIv) :
    (scaleListCIv S c l).length = l.length := by
  induction l with
  | nil => rfl
  | cons _ _ ih => simp [scaleListCIv, ih]

private lemma addListCIv_length (as bs : List CFpIv) :
    (addListCIv as bs).length = max as.length bs.length := by
  induction as generalizing bs with
  | nil => simp [addListCIv]
  | cons a as ih =>
    cases bs with
    | nil => simp [addListCIv]
    | cons b bs =>
      simp only [addListCIv, List.length_cons, ih]
      omega

private lemma mulLinListCIv_length (S : ℤ) (f0 f1 : CFpIv) (l : List CFpIv) :
    (mulLinListCIv S f0 f1 l).length = l.length + 1 := by
  simp [mulLinListCIv, addListCIv_length, scaleListCIv_length]

private lemma stepPolyCIv_length {n : ℕ} (S : ℤ) (wIv : Fin n → Fin n → CFpIv)
    (i : Fin n) (row : List CFpIv) (j : Fin n) :
    (stepPolyCIv S wIv i row j).length = row.length + if j = i then 0 else 1 := by
  unfold stepPolyCIv
  by_cases hji : j = i
  · simp [hji]
  · by_cases hlt : j < i
    · simp [hji, hlt, mulLinListCIv_length]
    · simp [hji, hlt, mulLinListCIv_length]

lemma polyListCIv_length {n : ℕ} (hn : 1 ≤ n) (S : ℤ) (wIv : Fin n → Fin n → CFpIv) (i : Fin n) :
    (polyListCIv S wIv i).length = n := by
  have hfold : ∀ (l : List (Fin n)) (row : List CFpIv),
      (l.foldl (stepPolyCIv S wIv i) row).length =
        row.length + (l.map fun j => if j = i then (0 : ℕ) else 1).sum := by
    intro l
    induction l with
    | nil => intro row; simp
    | cons j js ih =>
      intro row
      rw [List.foldl_cons, ih, stepPolyCIv_length, List.map_cons, List.sum_cons]
      omega
  unfold polyListCIv
  rw [hfold, List.length_singleton]
  have hsum_univ : ((List.finRange n).map fun j => if j = i then (0 : ℕ) else 1).sum =
      ∑ j : Fin n, (if j = i then (0 : ℕ) else 1) := by
    rw [← Multiset.sum_coe, ← Multiset.map_coe]
    exact (Finset.sum_eq_multiset_sum Finset.univ _).symm
  rw [hsum_univ]
  have hsplit : (∑ j : Fin n, (if j = i then (0 : ℕ) else 1)) =
      (if i = i then (0 : ℕ) else 1) + ∑ j ∈ Finset.univ.erase i, (if j = i then (0 : ℕ) else 1) :=
    (Finset.add_sum_erase Finset.univ _ (Finset.mem_univ i)).symm
  rw [hsplit]
  simp only [↓reduceIte, zero_add]
  have hconst : (∑ j ∈ Finset.univ.erase i, (if j = i then (0 : ℕ) else 1)) =
      ∑ _j ∈ Finset.univ.erase i, (1 : ℕ) := by
    refine Finset.sum_congr rfl fun j hj => ?_
    have hne : j ≠ i := (Finset.mem_erase.mp hj).1
    simp [hne]
  rw [hconst, Finset.sum_const, smul_eq_mul, mul_one, Finset.card_erase_of_mem (Finset.mem_univ i),
    Finset.card_fin]
  omega

private lemma getD_map_finRange' {α : Type*} {n : ℕ} (d : α) (f : Fin n → α) (c : Fin n) :
    ((List.finRange n).map f).getD c.1 d = f c := by
  simp [List.getD_eq_getElem?_getD, List.getElem_finRange]

/-- Interval rows of the full `26 × 26` stereographic Atiyah matrix at scale `sn`. -/
def rows26 (sn : ℤ) (tbl : List ℤ) : List (List CFpIv) :=
  (List.finRange 26).map fun i => polyListCIv S26 (mkWEntry26 (pts26OfSn sn) tbl) i

lemma rows26_mem {sn : ℤ} (hsn : 1 ≤ sn) {tbl : List ℤ}
    (hok : rhoTableOk26 (pts26OfSn sn) tbl = true) :
    MatCMem S26 26 (rows26 sn tbl) (atiyahMat (stereoSpinor (x26Clamp (sn : ℝ)).1)) := by
  refine ⟨by simp [rows26], fun i => ?_⟩
  rw [rows26, getD_map_finRange']
  refine ⟨polyListCIv_length (by norm_num) S26 _ i, fun k => ?_⟩
  have hmem := polyListCIv_mem S26_pos (w := stereoSlope (x26Clamp (sn : ℝ)).1)
    (fun a b hab => mkWEntry26_mem hsn hok a b hab) i k.1
  have hpoly := evalListC_polyListC_eq (stereoSlope (x26Clamp (sn : ℝ)).1)
    (stereoSpinor (x26Clamp (sn : ℝ)).1)
    (fun a b hba => by unfold stereoSpinor; simp [hba.ne', lt_asymm hba])
    (fun a b hab => by unfold stereoSpinor; simp [hab.ne, hab]) i
  have hentry : atiyahMat (stereoSpinor (x26Clamp (sn : ℝ)).1) i k =
      (polyListC (stereoSlope (x26Clamp (sn : ℝ)).1) i).getD k.1 0 := by
    rw [← coeff_evalListC, hpoly]; rfl
  rw [hentry]
  exact hmem

def certPos (r : Bool × CFpIv) : Bool := r.1 && decide (0 < r.2.re.lo)
def certNeg (r : Bool × CFpIv) : Bool := r.1 && decide (r.2.re.hi < 0)

def gauss26 (sn : ℤ) (tbl : List ℤ) : Bool × CFpIv :=
  gaussDetCIv S26 26 (rows26 sn tbl) (CFpIv.ofInt S26 1)

end Certification26

/-! ## Part 4: Staged kernel evaluation (polynomial rows in chunks, one pivot per step) -/

section Staging26

/-- One chunk of the row-polynomial products, applied to all `26` rows. -/
def stageP (sn : ℤ) (tbl : List ℤ) (chunk : List (Fin 26)) (prev : List (List CFpIv)) :
    List (List CFpIv) :=
  (List.finRange 26).map fun i =>
    chunk.foldl (stepPolyCIv S26 (mkWEntry26 (pts26OfSn sn) tbl) i) (prev.getD i.1 [])

def init26 : List (List CFpIv) := List.replicate 26 [CFpIv.ofInt S26 1]

def chunk0 : List (Fin 26) := [0, 1, 2, 3]
def chunk1 : List (Fin 26) := [4, 5, 6, 7]
def chunk2 : List (Fin 26) := [8, 9, 10, 11]
def chunk3 : List (Fin 26) := [12, 13, 14, 15]
def chunk4 : List (Fin 26) := [16, 17, 18, 19]
def chunk5 : List (Fin 26) := [20, 21, 22, 23]
def chunk6 : List (Fin 26) := [24, 25]

private lemma finRange26_chunks :
    List.finRange 26 = chunk0 ++ (chunk1 ++ (chunk2 ++ (chunk3 ++ (chunk4 ++ (chunk5 ++ chunk6))))) := by
  decide

private lemma init26_getD : ∀ i : Fin 26, init26.getD i.1 [] = [CFpIv.ofInt S26 1] := by
  decide

lemma rows26_eq_stages (sn : ℤ) (tbl : List ℤ) :
    rows26 sn tbl =
      stageP sn tbl chunk6 (stageP sn tbl chunk5 (stageP sn tbl chunk4 (stageP sn tbl chunk3
        (stageP sn tbl chunk2 (stageP sn tbl chunk1 (stageP sn tbl chunk0 init26)))))) := by
  unfold rows26
  conv_rhs => unfold stageP
  refine List.map_congr_left fun i _ => ?_
  simp only [getD_map_finRange', init26_getD]
  unfold polyListCIv
  rw [finRange26_chunks]
  simp only [List.foldl_append]

/-- One pivot step of `gaussDetCIv`. -/
def gaussHead (S : ℤ) (rows : List (List CFpIv)) (prod : CFpIv) :
    Bool × List (List CFpIv) × CFpIv :=
  match rows with
  | pRow :: rest =>
    (isSepCIv S (pRow.headD CFpIv.zero),
      elimRowsCIv S (pRow.headD CFpIv.zero) pRow.tail rest,
      CFpIv.mul S prod (pRow.headD CFpIv.zero))
  | [] => (false, [], prod)

lemma gaussDetCIv_step {S : ℤ} {m : ℕ} {rows rows' : List (List CFpIv)} {prod prod' : CFpIv}
    (h : gaussHead S rows prod = (true, rows', prod')) :
    gaussDetCIv S (m + 1) rows prod = gaussDetCIv S m rows' prod' := by
  cases rows with
  | nil => simp [gaussHead] at h
  | cons pRow rest =>
    simp only [gaussHead, Prod.mk.injEq] at h
    obtain ⟨h1, h2, h3⟩ := h
    rw [gaussDetCIv]
    simp only [h1, ↓reduceIte, h2, h3]

end Staging26


