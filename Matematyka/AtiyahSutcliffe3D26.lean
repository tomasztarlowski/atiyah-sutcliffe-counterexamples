private lemma x26Clamp_coords (t : ℝ) (i : Fin 26) :
    (x26Clamp t).1 i 0 = max t 1 * (x26BaseX i : ℝ) ∧
      (x26Clamp t).1 i 1 = max t 1 * (x26BaseY i : ℝ) ∧
      (x26Clamp t).1 i 2 = (x26BaseZ i : ℝ) :=
  ⟨rfl, rfl, rfl⟩

/-- The family `x26Clamp t` is genuinely non-coplanar for every `t`. -/
theorem x26Clamp_noncoplanar (t : ℝ) : Noncoplanar3D (x26Clamp t).1 := by
  rintro ⟨a, b, c, d, hne, hall⟩
  have hs : (1 : ℝ) ≤ max t 1 := le_max_right t 1
  have hb0 : x26BaseX 0 = -65 ∧ x26BaseY 0 = 0 ∧ x26BaseZ 0 = 0 := by decide
  have e0 : a * (max t 1 * (-65 : ℝ)) + b * (max t 1 * (0 : ℝ)) + c * (0 : ℝ) = d := by
    have h := hall 0
    rw [(x26Clamp_coords t 0).1, (x26Clamp_coords t 0).2.1, (x26Clamp_coords t 0).2.2,
      hb0.1, hb0.2.1, hb0.2.2] at h
    push_cast at h
    exact h
  have hb1 : x26BaseX 10 = 100 ∧ x26BaseY 10 = 0 ∧ x26BaseZ 10 = 3124 := by decide
  have e1 : a * (max t 1 * (100 : ℝ)) + b * (max t 1 * (0 : ℝ)) + c * (3124 : ℝ) = d := by
    have h := hall 10
    rw [(x26Clamp_coords t 10).1, (x26Clamp_coords t 10).2.1, (x26Clamp_coords t 10).2.2,
      hb1.1, hb1.2.1, hb1.2.2] at h
    push_cast at h
    exact h
  have hb2 : x26BaseX 24 = -385 ∧ x26BaseY 24 = -360 ∧ x26BaseZ 24 = 3467 := by decide
  have e2 : a * (max t 1 * (-385 : ℝ)) + b * (max t 1 * (-360 : ℝ)) + c * (3467 : ℝ) = d := by
    have h := hall 24
    rw [(x26Clamp_coords t 24).1, (x26Clamp_coords t 24).2.1, (x26Clamp_coords t 24).2.2,
      hb2.1, hb2.2.1, hb2.2.2] at h
    push_cast at h
    exact h
  have hb3 : x26BaseX 25 = -385 ∧ x26BaseY 25 = 360 ∧ x26BaseZ 25 = 3467 := by decide
  have e3 : a * (max t 1 * (-385 : ℝ)) + b * (max t 1 * (360 : ℝ)) + c * (3467 : ℝ) = d := by
    have h := hall 25
    rw [(x26Clamp_coords t 25).1, (x26Clamp_coords t 25).2.1, (x26Clamp_coords t 25).2.2,
      hb3.1, hb3.2.1, hb3.2.2] at h
    push_cast at h
    exact h
  have hA : a * max t 1 = 0 := by linarith
  have hB : b * max t 1 = 0 := by linarith
  have hC : c = 0 := by linarith
  have ha : a = 0 := (mul_eq_zero.mp hA).resolve_right (by linarith)
  have hb : b = 0 := (mul_eq_zero.mp hB).resolve_right (by linarith)
  rcases hne with h | h | h
  · exact h ha
  · exact h hb
  · exact h hC

