    rw [← Finset.prod_filter_mul_prod_filter_not Finset.univ (fun r : Fin 18 => sp18SubYPerm r = r)]
    have p1 : (∏ r ∈ Finset.univ.filter (fun r : Fin 18 => sp18SubYPerm r = r), f r) = 1 :=
